# Select exactly the channel combination needed by this deployment.
APP_ENV=production
REQUIRE_REDIS=true
REQUIRE_WEBHOOK_SECRETS=true
SESSION_TIMEOUT_SECONDS=600
IDEMPOTENCY_TTL_SECONDS=86400

# Telegram + WATI
TELEGRAM_ENABLED=true
WATI_ENABLED=true
TWILIO_ENABLED=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-public-domain/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# WATI WhatsApp
WATI_BASE_URL=https://live-mt-server.wati.io/your-tenant-id
WATI_API_KEY=
WATI_WEBHOOK_URL=https://your-public-domain/wati/webhook
WATI_WEBHOOK_SECRET=

# Twilio WhatsApp (use this instead of WATI when TWILIO_ENABLED=true)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WHATSAPP_ENABLED=true
TWILIO_WEBHOOK_URL=https://your-public-domain/twilio/webhook
TWILIO_VALIDATE_SIGNATURE=true

# Shared runtime settings
REDIS_URL=
HTTP_TIMEOUT=20
