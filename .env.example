# Telegram and WATI production configuration.
APP_ENV=production
REQUIRE_REDIS=true
REQUIRE_WEBHOOK_SECRETS=true
SESSION_TIMEOUT_SECONDS=600
IDEMPOTENCY_TTL_SECONDS=86400

TELEGRAM_ENABLED=true
WATI_ENABLED=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://your-public-domain/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# WATI WhatsApp
WATI_BASE_URL=https://live-mt-server.wati.io/your-tenant-id
WATI_API_KEY=
WATI_WEBHOOK_URL=https://your-public-domain/wati/webhook
WATI_WEBHOOK_SECRET=

# Shared runtime settings
REDIS_URL=
HTTP_TIMEOUT=20
